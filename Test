@pytest.fixture(scope="session")
def test_engine(tmp_path_factory):
    """
    Creates one isolated SQLite database for the entire test session.
    """
    db_path = tmp_path_factory.mktemp("db") / "test_glidewell.db"
    engine = create_engine(
        f"sqlite:///{db_path}",
        connect_args={"check_same_thread": False},
        poolclass=StaticPool,
    )
    Base.metadata.create_all(bind=engine)
    yield engine
    engine.dispose()


@pytest.fixture
def db_session(test_engine):
    """
    Provides a database session and cleans created rows after each test.
    """
    TestingSession = sessionmaker(
        bind=test_engine,
        autocommit=False,
        autoflush=False,
    )
    session = TestingSession()
    try:
        yield session
    finally:
        session.rollback()
        session.close()


@pytest.fixture
def client(test_engine, tmp_path, monkeypatch):
    """
    Provides a FastAPI TestClient using the isolated test database and uploads folder.
    """
    upload_dir = tmp_path / "uploads"
    upload_dir.mkdir(parents=True, exist_ok=True)

    monkeypatch.setattr("app.config.get_settings.UPLOAD_DIR", str(upload_dir))
    monkeypatch.setattr("app.routers.cases.settings.UPLOAD_DIR", str(upload_dir))

    TestingSession = sessionmaker(
        bind=test_engine,
        autocommit=False,
        autoflush=False,
    )

    def override_get_db():
        session = TestingSession()
        try:
            yield session
        finally:
            session.close()

    app.dependency_overrides[get_db] = override_get_db

    with TestClient(app) as test_client:
        yield test_client

    app.dependency_overrides.clear()


