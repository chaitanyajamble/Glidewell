def test_upload_case_file(
    client,
    dentist_headers,
    seeded_product,
    future_due_date,
):
    created = create_case(
        client,
        dentist_headers,
        seeded_product.id,
        future_due_date,
    )
    case_id = created.json()["id"]

    file_content = b"fake-png-content"
    response = client.post(
        f"/api/cases/{case_id}/files",
        headers=dentist_headers,
        files={
            "file": (
                "scan.png",
                io.BytesIO(file_content),
                "image/png",
            )
        },
    )

    assert response.status_code == 201
    body = response.json()

    assert len(body["files"]) == 1
    uploaded_file = body["files"][0]

    assert uploaded_file["original_filename"] == "scan.png"
    assert uploaded_file["content_type"] == "image/png"
    assert uploaded_file["size_bytes"] == len(file_content)
    assert uploaded_file["file_url"].startswith("/uploads/")


