    db.commit()
import re

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.orm import Session

from app.database import get_db
from app.dependencies import require_admin
from app.models import Article
from app.schemas import ArticleCreate, ArticleOut

router = APIRouter(prefix="/api/articles", tags=["Content"])


def slugify(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


@router.get("", response_model=list[ArticleOut])
def list_articles(
    category: str | None = Query(default=None, max_length=120),
    search: str | None = Query(default=None, max_length=100),
    db: Session = Depends(get_db),
):
    query = db.query(Article).filter(Article.is_published.is_(True))

    if category:
        query = query.filter(Article.category.ilike(category))
    if search:
        query = query.filter(Article.title.ilike(f"%{search}%"))

    return query.order_by(Article.published_at.desc().nullslast()).all()


@router.get("/{slug}", response_model=ArticleOut)
def get_article(slug: str, db: Session = Depends(get_db)):
    article = db.query(Article).filter(Article.slug == slug).first()
    if not article or not article.is_published:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Article not found")
    return article


@router.post("", response_model=ArticleOut, status_code=status.HTTP_201_CREATED)
def create_article(
    payload: ArticleCreate,
    db: Session = Depends(get_db),
    _: object = Depends(require_admin),
):
    slug = slugify(payload.title)
    if db.query(Article).filter(Article.slug == slug).first():
        raise HTTPException(status.HTTP_409_CONFLICT, "Article slug already exists")

    article = Article(**payload.model_dump(), slug=slug)
    db.add(article)
    db.commit()
    db.refresh(article)
    return article


@router.delete("/{article_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_article(
    article_id: int,
    db: Session = Depends(get_db),
    _: object = Depends(require_admin),
):
    article = db.query(Article).filter(Article.id == article_id).first()
    if not article:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Article not found")

    db.delete(article)
    db.commit()
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session

from app.database import get_db
from app.dependencies import require_admin
from app.models import ContactMessage
from app.schemas import ContactMessageCreate, ContactMessageOut

router = APIRouter(prefix="/api/contact", tags=["Contact"])


@router.post("", response_model=ContactMessageOut, status_code=status.HTTP_201_CREATED)
def submit_contact_message(
    payload: ContactMessageCreate,
    db: Session = Depends(get_db),
):
    message = ContactMessage(**payload.model_dump())
    db.add(message)
    db.commit()
    db.refresh(message)
    return message


@router.get("", response_model=list[ContactMessageOut])
def list_messages(
    handled: bool | None = None,
    db: Session = Depends(get_db),
    _: object = Depends(require_admin),
):
    query = db.query(ContactMessage)

    if handled is not None:
        query = query.filter(ContactMessage.is_handled.is_(handled))

    return query.order_by(ContactMessage.created_at.desc()).all()


@router.patch("/{message_id}/handle", response_model=ContactMessageOut)
def mark_message_handled(
    message_id: int,
    db: Session = Depends(get_db),
    _: object = Depends(require_admin),
):
    message = db.query(ContactMessage).filter(ContactMessage.id == message_id).first()
    if not message:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Message not found")

    message.is_handled = True
    db.commit()
    db.refresh(message)
    return message
import os

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles

from app.config import get_settings
from app.database import Base, SessionLocal, engine
from app.routers import (
    auth,
    cases,
    catalog,
    contact,
    content,
    events,
    users,
)
from app.seed import seed_initial_data

settings = get_settings()

app = FastAPI(
    title=settings.APP_NAME,
    description=(
        "Backend API for a dental laboratory platform: practitioner accounts, "
        "product catalog, dental case submission, case tracking, CE events, "
        "articles, and contact inquiries."
    ),
    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.cors_origin_list,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

os.makedirs(settings.UPLOAD_DIR, exist_ok=True)
app.mount("/uploads", StaticFiles(directory=settings.UPLOAD_DIR), name="uploads")

app.include_router(auth.router)
app.include_router(users.router)
app.include_router(catalog.router)
app.include_router(cases.router)
app.include_router(events.router)
app.include_router(content.router)
app.include_router(contact.router)


@app.on_event("startup")
def on_startup():
    Base.metadata.create_all(bind=engine)
    db = SessionLocal()
    try:
        seed_initial_data(db)
    finally:
        db.close()


@app.get("/", tags=["Health"])
def root():
    return {
        "name": settings.APP_NAME,
        "status": "ok",
        "docs": "/docs",
        "environment": settings.ENVIRONMENT,
    }


@app.get("/health", tags=["Health"])
def health_check():
    return {"status": "healthy"}
from datetime import datetime, timedelta, timezone

from sqlalchemy.orm import Session

from app.config import get_settings
from app.models import (
    Article,
    Event,
    Product,
    ProductCategory,
    User,
    UserRole,
)
from app.security import hash_password

settings = get_settings()


def seed_initial_data(db: Session) -> None:
    if not db.query(User).filter(User.email == settings.FIRST_ADMIN_EMAIL.lower()).first():
        db.add(
            User(
                email=settings.FIRST_ADMIN_EMAIL.lower(),
                full_name=settings.FIRST_ADMIN_NAME,
                hashed_password=hash_password(settings.FIRST_ADMIN_PASSWORD),
                role=UserRole.ADMIN,
                practice_name="Glidewell Administration",
            )
        )

    if db.query(ProductCategory).count() == 0:
        categories = [
            ProductCategory(
                name="Crown & Bridge",
                slug="crown-and-bridge",
                description="Zirconia, PFM, glass ceramics, composite, and full-cast restorations.",
            ),
            ProductCategory(
                name="Implant Solutions",
                slug="implant-solutions",
                description="Implant restorations, planning, and full-arch solutions.",
            ),
            ProductCategory(
                name="Occlusal Appliances",
                slug="occlusal-appliances",
                description="Bite splints, retainers, mouthguards, and sleep appliances.",
            ),
            ProductCategory(
                name="Removables",
                slug="removables",
                description="Dentures, partials, flippers, and combination restorations.",
            ),
        ]
        db.add_all(categories)
        db.flush()

        products = [
            Product(
                name="BruxZir Zirconia Crown",
                slug="bruxzir-zirconia-crown",
                description="High-strength zirconia restoration for posterior and anterior indications.",
                category_id=categories[0].id,
                price=149.00,
            ),
            Product(
                name="Glidewell HT Implant Restoration",
                slug="glidewell-ht-implant-restoration",
                description="Implant restoration workflow and restorative components.",
                category_id=categories[1].id,
                price=299.00,
            ),
            Product(
                name="Comfort H/S Bite Splint",
                slug="comfort-h-s-bite-splint",
                description="Hard-soft bite splint for occlusal protection.",
                category_id=categories[2].id,
                price=119.00,
            ),
            Product(
                name="3D Flexible Partial Denture",
                slug="3d-flexible-partial-denture",
                description="Flexible removable partial denture solution.",
                category_id=categories[3].id,
                price=399.00,
            ),
        ]
        db.add_all(products)

    if db.query(Event).count() == 0:
        now = datetime.now(timezone.utc)
        db.add_all(
            [
                Event(
                    title="Implant Surgery: Comprehensive Review",
                    event_type="live_course",
                    description="A comprehensive live course covering guided and freehand implant techniques.",
                    location="Louisville, KY",
                    starts_at=now + timedelta(days=7),
                    ends_at=now + timedelta(days=8),
                ),
                Event(
                    title="Evidence-Based Strategies for Long-Term Success",
                    event_type="webinar",
                    description="Online webinar on evidence-based restorative strategies.",
                    location="Online",
                    starts_at=now + timedelta(days=10),
                ),
            ]
        )

    if db.query(Article).count() == 0:
        db.add_all(
            [
                Article(
                    title="Getting Started with Digital Case Submission",
                    slug="getting-started-with-digital-case-submission",
                    category="Digital Dentistry",
                    excerpt="Learn how to submit scans, photos, and prescriptions for a dental lab case.",
                    body=(
                        "Digital case submission helps practices send prescriptions, "
                        "intraoral scans, and clinical photographs to the laboratory "
                        "in a structured workflow."
                    ),
                    author="Glidewell Backend Demo",
                    published_at=datetime.now(timezone.utc),
                ),
                Article(
                    title="Understanding Dental Case Statuses",
                    slug="understanding-dental-case-statuses",
                    category="Practice Operations",
                    excerpt="A guide to tracking a case from receipt through delivery.",
                    body=(
                        "Cases move through received, design, production, quality check, "
                        "shipping, and delivery stages."
                    ),
                    author="Glidewell Backend Demo",
                    published_at=datetime.now(timezone.utc),
                ),
            ]
        )

