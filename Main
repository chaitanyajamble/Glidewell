router = APIRouter(prefix="/api/cases", tags=["Dental Cases"])
settings = get_settings()

ALLOWED_UPLOAD_TYPES = {
    "image/jpeg",
    "image/png",
    "image/webp",
    "application/pdf",
    "application/zip",
}


@router.get("", response_model=list[CaseOut])
def list_cases(
    status_filter: CaseStatus | None = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    query = db.query(DentalCase)

    if current_user.role == UserRole.DENTIST:
        query = query.filter(DentalCase.owner_id == current_user.id)
    if status_filter:
        query = query.filter(DentalCase.status == status_filter)

    return query.order_by(DentalCase.created_at.desc()).all()


@router.post("", response_model=CaseOut, status_code=status.HTTP_201_CREATED)
def create_case(
    payload: CaseCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    if payload.product_id:
        product = db.query(Product).filter(Product.id == payload.product_id).first()
        if not product:
            raise HTTPException(status.HTTP_400_BAD_REQUEST, "Invalid product")

    case = DentalCase(
        case_number=generate_case_number(),
        owner_id=current_user.id,
        **payload.model_dump(),
    )
    db.add(case)
    db.flush()

    db.add(
        CaseStatusHistory(
            case_id=case.id,
            status=CaseStatus.RECEIVED,
            note="Case submitted",
        )
    )

    db.commit()
    db.refresh(case)
    return case


@router.get("/{case_id}", response_model=CaseOut)
def get_case(
    case_id: str,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    case = get_case_or_404(db, case_id)

    if current_user.role == UserRole.DENTIST and case.owner_id != current_user.id:
        raise HTTPException(status.HTTP_403_FORBIDDEN, "Not authorized")

    return case


@router.patch("/{case_id}", response_model=CaseOut)
def update_case(
    case_id: str,
    payload: CaseUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    case = get_case_or_404(db, case_id)
    is_owner = case.owner_id == current_user.id
    is_lab_user = current_user.role in {UserRole.ADMIN, UserRole.STAFF}

    if not is_owner and not is_lab_user:
        raise HTTPException(status.HTTP_403_FORBIDDEN, "Not authorized")

    data = payload.model_dump(exclude_unset=True)

    if not is_lab_user:
        data.pop("status", None)

    new_status = data.pop("status", None)
    for field, value in data.items():
        setattr(case, field, value)

    if new_status and new_status != case.status:
        case.status = new_status
        db.add(
            CaseStatusHistory(
                case_id=case.id,
                status=new_status,
                note=f"Status changed by {current_user.email}",
            )
        )

    db.commit()
    db.refresh(case)
    return case


@router.post(
    "/{case_id}/files",
    response_model=CaseOut,
    status_code=status.HTTP_201_CREATED,
)
async def upload_case_file(
    case_id: str,
    file: UploadFile = File(...),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    case = get_case_or_404(db, case_id)

    if current_user.role == UserRole.DENTIST and case.owner_id != current_user.id:
        raise HTTPException(status.HTTP_403_FORBIDDEN, "Not authorized")

    if file.content_type not in ALLOWED_UPLOAD_TYPES:
        raise HTTPException(
            status.HTTP_400_BAD_REQUEST,
            f"Unsupported file type. Allowed: {', '.join(sorted(ALLOWED_UPLOAD_TYPES))}",
        )

    contents = await file.read()
    if len(contents) > settings.max_upload_size_bytes:
        raise HTTPException(
            status.HTTP_413_REQUEST_ENTITY_TOO_LARGE,
            f"File exceeds {settings.MAX_UPLOAD_SIZE_MB} MB limit",
        )

    os.makedirs(settings.UPLOAD_DIR, exist_ok=True)
    extension = os.path.splitext(file.filename or "upload")[1][:10]
    stored_filename = f"{case.id}_{secrets.token_hex(12)}{extension}"
    file_path = os.path.join(settings.UPLOAD_DIR, stored_filename)

    with open(file_path, "wb") as output:
        output.write(contents)

    case_file = CaseFile(
        case_id=case.id,
        original_filename=file.filename or "upload",
        stored_filename=stored_filename,
        file_url=f"/uploads/{stored_filename}",
        content_type=file.content_type,
        size_bytes=len(contents),
    )
    db.add(case_file)
    db.commit()
    db.refresh(case)
    return case


@router.delete("/{case_id}", status_code=status.HTTP_204_NO_CONTENT)
def cancel_case(
    case_id: str,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    case = get_case_or_404(db, case_id)

    if current_user.role == UserRole.DENTIST and case.owner_id != current_user.id:
        raise HTTPException(status.HTTP_403_FORBIDDEN, "Not authorized")

    if case.status in {CaseStatus.SHIPPED, CaseStatus.DELIVERED}:
        raise HTTPException(
            status.HTTP_400_BAD_REQUEST,
            "Shipped or delivered cases cannot be cancelled",
        )

    case.status = CaseStatus.CANCELLED
    db.add(
        CaseStatusHistory(
            case_id=case.id,
            status=CaseStatus.CANCELLED,
            note=f"Cancelled by {current_user.email}",
        )
    )
    db.commit()


def get_case_or_404(db: Session, case_id: str) -> DentalCase:
    case = db.query(DentalCase).filter(DentalCase.id == case_id).first()
    if not case:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Case not found")
    return case


def generate_case_number() -> str:
    return f"GW-{datetime.now(timezone.utc).strftime('%Y%m%d')}-{secrets.token_hex(3).upper()}"
