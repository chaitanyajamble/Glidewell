router = APIRouter(prefix="/api/events", tags=["Education & Events"])


@router.get("", response_model=list[EventOut])
def list_events(
    include_unpublished: bool = False,
    db: Session = Depends(get_db),
):
    query = db.query(Event)

    if not include_unpublished:
